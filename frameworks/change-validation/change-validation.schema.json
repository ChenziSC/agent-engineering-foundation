{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agent-foundation/change-validation.schema.json",
  "title": "Change Validation Matrix v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "change_id", "changed_paths", "rules", "checks", "browser_scenarios", "manual_gates"],
  "properties": {
    "version": { "const": 1 },
    "change_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$" },
    "changed_paths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "rules": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/rule" } },
    "checks": { "type": "array", "items": { "$ref": "#/$defs/check" } },
    "browser_scenarios": { "type": "array", "items": { "$ref": "#/$defs/browser" } },
    "manual_gates": { "type": "array", "items": { "$ref": "#/$defs/manual" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$" },
    "status": { "enum": ["planned", "passed", "failed", "blocked"] },
    "rule": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "path_prefixes", "required_checks", "required_browser_scenarios", "required_manual_gates"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "path_prefixes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "required_checks": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "required_browser_scenarios": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "required_manual_gates": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
      }
    },
    "check": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "command", "status", "evidence_ref"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "command": { "type": "string", "minLength": 1 }, "status": { "$ref": "#/$defs/status" }, "evidence_ref": { "type": ["string", "null"] } }
    },
    "browser": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "page", "version", "preconditions", "actions", "expected", "status", "evidence_ref"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "page": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 },
        "preconditions": { "type": "array", "items": { "type": "string" } }, "actions": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "expected": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "status": { "$ref": "#/$defs/status" }, "evidence_ref": { "type": ["string", "null"] }
      }
    },
    "manual": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "question", "status", "evidence_ref"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "question": { "type": "string", "minLength": 1 }, "status": { "$ref": "#/$defs/status" }, "evidence_ref": { "type": ["string", "null"] } }
    }
  }
}
