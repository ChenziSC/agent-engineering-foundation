{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agent-foundation/context-contract.schema.json",
  "title": "Context Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "contract_id",
    "scope",
    "ownership",
    "project_rules",
    "stable_contracts",
    "dynamic_views",
    "evidence",
    "unresolved",
    "refresh_triggers"
  ],
  "properties": {
    "version": { "const": 1 },
    "contract_id": { "$ref": "#/$defs/id" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paths", "entrypoints"],
      "properties": {
        "paths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "entrypoints": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner_role", "approval_status", "approved_at"],
      "properties": {
        "owner_role": { "type": "string", "minLength": 1 },
        "approval_status": { "enum": ["draft", "approved", "review-required"] },
        "approved_at": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "project_rules": {
      "type": "array",
      "items": { "$ref": "#/$defs/projectRule" }
    },
    "stable_contracts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/stableContract" }
    },
    "dynamic_views": {
      "type": "array",
      "items": { "$ref": "#/$defs/dynamicView" }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/evidence" }
    },
    "unresolved": {
      "type": "array",
      "items": { "$ref": "#/$defs/unresolved" }
    },
    "refresh_triggers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$" },
    "evidenceRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "projectRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "evidence_refs"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "statement": { "type": "string", "minLength": 1 },
        "evidence_refs": { "$ref": "#/$defs/evidenceRefs" }
      }
    },
    "stableContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "statement", "evidence_refs", "refresh_triggers"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["interface", "schema", "state", "invariant", "flow", "compatibility"] },
        "statement": { "type": "string", "minLength": 1 },
        "evidence_refs": { "$ref": "#/$defs/evidenceRefs" },
        "refresh_triggers": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entrypoint", "symbol", "data_element"],
      "properties": {
        "entrypoint": { "type": ["string", "null"], "minLength": 1 },
        "symbol": { "type": ["string", "null"], "minLength": 1 },
        "data_element": { "type": ["string", "null"], "minLength": 1 }
      },
      "anyOf": [
        { "properties": { "entrypoint": { "type": "string" } } },
        { "properties": { "symbol": { "type": "string" } } },
        { "properties": { "data_element": { "type": "string" } } }
      ]
    },
    "dynamicView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "anchor", "status", "artifact_ref", "source_revision"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "anchor": { "$ref": "#/$defs/anchor" },
        "status": { "enum": ["planned", "generated", "stale"] },
        "artifact_ref": { "type": ["string", "null"], "minLength": 1 },
        "source_revision": { "type": ["string", "null"], "minLength": 1 }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "ref", "digest", "observed_at"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["code", "test", "schema", "runtime", "human-confirmation", "public-doc"] },
        "ref": { "type": "string", "minLength": 1 },
        "digest": { "type": ["string", "null"], "minLength": 1 },
        "observed_at": { "type": "string", "format": "date-time" }
      }
    },
    "unresolved": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "question", "impact", "blocking"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "question": { "type": "string", "minLength": 1 },
        "impact": { "type": "string", "minLength": 1 },
        "blocking": { "type": "boolean" }
      }
    }
  }
}
