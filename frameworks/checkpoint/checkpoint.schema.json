{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agent-foundation/checkpoint.schema.json",
  "title": "Agent Checkpoint v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run", "stages", "events", "decisions", "external_refs", "integrity"],
  "properties": {
    "schema_version": { "const": 1 },
    "run": { "$ref": "#/$defs/run" },
    "stages": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/stage" } },
    "events": { "type": "array", "items": { "$ref": "#/$defs/event" } },
    "decisions": { "type": "array", "items": { "$ref": "#/$defs/decision" } },
    "external_refs": { "type": "array", "items": { "$ref": "#/$defs/external_ref" } },
    "integrity": { "$ref": "#/$defs/integrity" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "task_type", "status", "current_stage_id", "updated_at"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "task_type": { "type": "string", "minLength": 1 },
        "status": { "enum": ["active", "paused", "blocked", "completed", "cancelled"] },
        "current_stage_id": { "$ref": "#/$defs/id" },
        "updated_at": { "type": "string", "format": "date-time" }
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "replay_policy", "input_digest", "exit_gate"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "status": { "enum": ["pending", "active", "paused", "blocked", "completed", "skipped"] },
        "replay_policy": { "enum": ["idempotent", "verify-before-replay", "manual-only"] },
        "input_digest": { "$ref": "#/$defs/digest" },
        "exit_gate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reasons"],
          "properties": {
            "status": { "enum": ["unknown", "allowed", "denied"] },
            "reasons": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "id", "type", "stage_id", "occurred_at", "summary"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 1 },
        "id": { "$ref": "#/$defs/id" },
        "type": { "enum": ["stage-started", "stage-paused", "stage-completed", "stage-blocked", "reference-invalidated", "resume-planned"] },
        "stage_id": { "$ref": "#/$defs/id" },
        "occurred_at": { "type": "string", "format": "date-time" },
        "summary": { "type": "string", "minLength": 1 }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "actor_type", "stage_id", "decision", "decided_at"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "actor_type": { "enum": ["human", "policy"] },
        "stage_id": { "$ref": "#/$defs/id" },
        "decision": { "enum": ["continue", "skip", "revalidate", "cancel"] },
        "decided_at": { "type": "string", "format": "date-time" }
      }
    },
    "external_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "content_digest", "status"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "enum": ["evidence", "claim", "file", "external-artifact", "other"] },
        "content_digest": { "$ref": "#/$defs/digest" },
        "status": { "enum": ["valid", "stale", "unknown"] }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "canonicalization", "payload_digest"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "canonicalization": { "const": "canonical-json-without-integrity" },
        "payload_digest": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
