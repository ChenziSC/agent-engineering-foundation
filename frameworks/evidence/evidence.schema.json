{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agent-foundation/evidence.schema.json",
  "title": "Evidence Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bundle_id", "created_at", "evidence", "claims", "blockers", "verifications", "integrity"],
  "properties": {
    "schema_version": { "const": 1 },
    "bundle_id": { "$ref": "#/$defs/id" },
    "created_at": { "type": "string", "format": "date-time" },
    "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
    "claims": { "type": "array", "items": { "$ref": "#/$defs/claim" } },
    "blockers": { "type": "array", "items": { "$ref": "#/$defs/blocker" } },
    "verifications": { "type": "array", "items": { "$ref": "#/$defs/verification" } },
    "integrity": { "$ref": "#/$defs/integrity" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source_type", "observed_at", "scope", "summary", "content_digest", "status"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "source_type": { "enum": ["browser", "file", "repository", "measurement", "human-confirmation", "other"] },
        "observed_at": { "type": "string", "format": "date-time" },
        "scope": { "type": "string", "minLength": 1, "maxLength": 500 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "content_digest": { "$ref": "#/$defs/digest" },
        "status": { "enum": ["valid", "conflicted", "stale"] }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "statement", "evidence_refs", "blocker_refs", "status"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["observation", "derived", "inference"] },
        "statement": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "evidence_refs": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "blocker_refs": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "status": { "enum": ["supported", "partial", "blocked", "refuted", "stale"] }
      }
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "reason", "affected_claim_refs"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "affected_claim_refs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" }, "uniqueItems": true }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "claim_ref", "action", "expected_observation", "actual_observation", "status"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "claim_ref": { "$ref": "#/$defs/id" },
        "action": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "expected_observation": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "actual_observation": { "type": ["string", "null"], "maxLength": 2000 },
        "status": { "enum": ["planned", "passed", "failed", "inconclusive"] }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "canonicalization", "payload_digest"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "canonicalization": { "const": "canonical-json-without-integrity" },
        "payload_digest": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
