{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agent-foundation/design-contract.schema.json",
  "title": "Design Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "design", "implementation", "acceptance", "evidence"],
  "properties": {
    "version": { "const": 1 },
    "design": { "type": "object", "additionalProperties": false, "required": ["source_type", "source_ref", "source_version", "frames"], "properties": { "source_type": { "enum": ["design-file", "image", "document", "other"] }, "source_ref": { "type": "string", "minLength": 1 }, "source_version": { "type": "string", "minLength": 1 }, "frames": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } } } },
    "implementation": { "type": "object", "additionalProperties": false, "required": ["target_paths", "reuse_candidates", "constraints"], "properties": { "target_paths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } }, "reuse_candidates": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }, "constraints": { "type": "array", "items": { "type": "string" } } } },
    "acceptance": { "type": "object", "additionalProperties": false, "required": ["viewports", "states", "interactions", "accessibility"], "properties": { "viewports": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } }, "states": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["normal", "loading", "empty", "error", "disabled", "permission"] } }, "interactions": { "type": "array", "items": { "type": "string" } }, "accessibility": { "type": "array", "items": { "type": "string" } } } },
    "evidence": { "type": "object", "additionalProperties": false, "required": ["visual_refs", "behavior_refs", "status"], "properties": { "visual_refs": { "type": "array", "items": { "type": "string" } }, "behavior_refs": { "type": "array", "items": { "type": "string" } }, "status": { "enum": ["planned", "partial", "validated"] } } }
  }
}
