{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agent-foundation/eval-run.schema.json",
  "title": "Skill Eval Run",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "skill", "executed_at", "environment", "rubric", "cases", "summary", "integrity"],
  "properties": {
    "schema_version": { "const": 1 },
    "run_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$" },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "behavior_digest"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
        "behavior_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "executed_at": { "type": "string", "format": "date-time" },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "tools", "configuration_ref"],
      "properties": {
        "host": { "type": "string", "minLength": 1 },
        "tools": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "configuration_ref": { "type": ["string", "null"] }
      }
    },
    "rubric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest", "threshold"],
      "properties": {
        "path": { "const": "evals/rubric.md" },
        "digest": { "$ref": "#/$defs/digest" },
        "threshold": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "cases": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/case" } },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "pass", "fail", "inconclusive", "blocking_failures", "average_score"],
      "properties": {
        "result": { "enum": ["pass", "fail", "inconclusive"] },
        "pass": { "type": "integer", "minimum": 0 },
        "fail": { "type": "integer", "minimum": 0 },
        "inconclusive": { "type": "integer", "minimum": 0 },
        "blocking_failures": { "type": "integer", "minimum": 0 },
        "average_score": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "integrity": { "$ref": "#/$defs/integrity" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "evidence_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]{1,31}$" }, "uniqueItems": true },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "case_path", "case_digest", "trace_path", "trace_digest", "result", "score", "blocking_violations", "dimensions", "required_actions", "forbidden_actions", "inconclusive"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
        "case_path": { "type": "string" },
        "case_digest": { "$ref": "#/$defs/digest" },
        "trace_path": { "type": "string" },
        "trace_digest": { "$ref": "#/$defs/digest" },
        "result": { "enum": ["pass", "fail", "inconclusive"] },
        "score": { "type": "number", "minimum": 0, "maximum": 100 },
        "blocking_violations": { "type": "array", "items": { "$ref": "#/$defs/blocking_violation" } },
        "dimensions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/dimension" } },
        "required_actions": { "type": "array", "items": { "$ref": "#/$defs/required_action" } },
        "forbidden_actions": { "type": "array", "items": { "$ref": "#/$defs/forbidden_action" } },
        "inconclusive": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "blocking_violation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "evidence_refs"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
        "evidence_refs": { "$ref": "#/$defs/evidence_refs" }
      }
    },
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "weight", "score", "status", "evidence_refs"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "weight": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 },
        "score": { "type": "number", "minimum": 0, "maximum": 100 },
        "status": { "enum": ["assessed", "inconclusive"] },
        "evidence_refs": { "$ref": "#/$defs/evidence_refs" }
      }
    },
    "required_action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "evidence_refs"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
        "status": { "enum": ["pass", "fail", "inconclusive"] },
        "evidence_refs": { "$ref": "#/$defs/evidence_refs" }
      }
    },
    "forbidden_action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "occurred", "evidence_refs"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
        "occurred": { "type": "boolean" },
        "evidence_refs": { "$ref": "#/$defs/evidence_refs" }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "canonicalization", "payload_digest"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "canonicalization": { "const": "canonical-json-without-integrity" },
        "payload_digest": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
