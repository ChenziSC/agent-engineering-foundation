{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/specflow/relation-transaction.schema.json",
  "title": "Specflow Relation Transaction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "transaction_id",
    "created_at",
    "relation_type",
    "authorization",
    "reason",
    "participants",
    "evidence_refs",
    "integrity"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "transaction_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,99}$" },
    "created_at": { "type": "string", "format": "date-time" },
    "relation_type": { "enum": ["parent-child", "supersession"] },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confirmed", "confirmed_at", "authority", "evidence_ref"],
      "properties": {
        "confirmed": { "const": true },
        "confirmed_at": { "type": "string", "format": "date-time" },
        "authority": { "type": "string", "minLength": 1 },
        "evidence_ref": { "type": "string", "minLength": 1 }
      }
    },
    "reason": { "type": "string", "minLength": 1 },
    "participants": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["spec_id", "spec_dir", "event_candidate", "sequence", "event_digest"],
        "properties": {
          "spec_id": { "type": "string", "minLength": 1 },
          "spec_dir": { "type": "string", "pattern": "^\\./" },
          "event_candidate": { "type": "string", "pattern": "^\\./" },
          "sequence": { "type": "integer", "minimum": 1 },
          "event_digest": { "$ref": "#/$defs/digest" }
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "canonicalization", "transaction_digest"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "canonicalization": { "type": "string", "minLength": 1 },
        "transaction_digest": { "$ref": "#/$defs/digest" }
      }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
