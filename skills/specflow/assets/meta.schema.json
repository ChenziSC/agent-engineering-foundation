{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/specflow/meta.schema.json",
  "title": "Specflow Meta",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "status",
    "created_at",
    "updated_at",
    "scope",
    "relations",
    "artifacts",
    "freshness",
    "active_context",
    "authorization"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,127}$" },
    "title": { "type": "string", "minLength": 1 },
    "status": { "enum": ["draft", "planned", "in-progress", "archived", "superseded", "cancelled"] },
    "created_at": { "type": "string", "format": "date" },
    "updated_at": { "type": "string", "format": "date" },
    "scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "relations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parent", "children", "supersedes", "superseded_by"],
      "properties": {
        "parent": { "type": ["string", "null"], "minLength": 1 },
        "children": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "supersedes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "superseded_by": { "type": ["string", "null"], "minLength": 1 }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spec", "plan", "tasks", "research", "validation_report"],
      "properties": {
        "spec": { "$ref": "#/$defs/localPath" },
        "plan": { "$ref": "#/$defs/localPath" },
        "tasks": { "$ref": "#/$defs/localPath" },
        "research": { "anyOf": [{ "$ref": "#/$defs/localPath" }, { "type": "null" }] },
        "validation_report": { "$ref": "#/$defs/localPath" },
        "archive_receipt": { "anyOf": [{ "$ref": "#/$defs/localPath" }, { "type": "null" }] },
        "lifecycle_dir": { "anyOf": [{ "$ref": "#/$defs/localPath" }, { "type": "null" }] }
      }
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "last_reviewed_at", "refresh_triggers"],
      "properties": {
        "status": { "enum": ["current", "review-required", "stale"] },
        "last_reviewed_at": { "type": "string", "format": "date" },
        "refresh_triggers": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "active_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "next_task_id"],
      "properties": {
        "summary": { "type": "string", "minLength": 1 },
        "next_task_id": { "type": ["string", "null"], "minLength": 1 }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["terminal_transition_confirmed"],
      "properties": {
        "terminal_transition_confirmed": { "type": "boolean" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "enum": ["archived", "superseded", "cancelled"] } }, "required": ["status"] },
      "then": {
        "properties": {
          "artifacts": { "required": ["archive_receipt", "lifecycle_dir"] },
          "authorization": { "properties": { "terminal_transition_confirmed": { "const": true } } }
        }
      },
      "else": {
        "properties": {
          "authorization": { "properties": { "terminal_transition_confirmed": { "const": false } } }
        }
      }
    }
  ],
  "$defs": {
    "localPath": { "type": "string", "pattern": "^\\./[^/].*" }
  }
}
