{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/specflow/lifecycle-event.schema.json",
  "title": "Specflow Lifecycle Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "spec_id",
    "sequence",
    "event_type",
    "created_at",
    "transition",
    "authorization",
    "reason",
    "relation_changes",
    "evidence_refs",
    "integrity"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "event_id": { "type": "string", "minLength": 1 },
    "spec_id": { "type": "string", "minLength": 1 },
    "sequence": { "type": "integer", "minimum": 1 },
    "event_type": { "enum": ["superseded", "cancelled", "relation-updated", "freshness-reviewed"] },
    "created_at": { "type": "string", "format": "date-time" },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": { "enum": ["archived", "superseded", "cancelled"] },
        "to": { "enum": ["archived", "superseded", "cancelled"] }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confirmed", "confirmed_at", "authority", "evidence_ref"],
      "properties": {
        "confirmed": { "const": true },
        "confirmed_at": { "type": "string", "format": "date-time" },
        "authority": { "type": "string", "minLength": 1 },
        "evidence_ref": { "type": "string", "minLength": 1 }
      }
    },
    "reason": { "type": "string", "minLength": 1 },
    "relation_changes": { "type": "object" },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "canonicalization", "previous_digest", "event_digest"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "canonicalization": { "type": "string", "minLength": 1 },
        "previous_digest": { "$ref": "#/$defs/digest" },
        "event_digest": { "$ref": "#/$defs/digest" }
      }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-fA-F0-9]{64}$" }
  }
}
