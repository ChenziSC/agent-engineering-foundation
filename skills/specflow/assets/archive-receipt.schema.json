{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/specflow/archive-receipt.schema.json",
  "title": "Specflow Archive Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "spec_id",
    "created_at",
    "transition",
    "authorization",
    "snapshot",
    "validation",
    "knowledge_projection",
    "relations_snapshot",
    "integrity"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "receipt_id": { "type": "string", "minLength": 1 },
    "spec_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "transition": { "$ref": "#/$defs/transition" },
    "authorization": { "$ref": "#/$defs/authorization" },
    "snapshot": { "$ref": "#/$defs/snapshot" },
    "validation": { "$ref": "#/$defs/validation" },
    "knowledge_projection": { "$ref": "knowledge-projection.schema.json" },
    "relations_snapshot": { "$ref": "#/$defs/relations" },
    "integrity": { "$ref": "#/$defs/integrity" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-fA-F0-9]{64}$" },
    "status": { "enum": ["draft", "planned", "in-progress", "archived", "superseded", "cancelled"] },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": { "enum": ["draft", "planned", "in-progress"] },
        "to": { "enum": ["archived", "superseded", "cancelled"] }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confirmed", "confirmed_at", "authority", "evidence_ref"],
      "properties": {
        "confirmed": { "const": true },
        "confirmed_at": { "type": "string", "format": "date-time" },
        "authority": { "type": "string", "minLength": 1 },
        "evidence_ref": { "type": "string", "minLength": 1 }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_revision", "base_revision", "change", "artifacts"],
      "properties": {
        "source_revision": { "type": "string", "minLength": 1 },
        "base_revision": { "type": "string", "minLength": 1 },
        "change": {
          "type": "object",
          "additionalProperties": false,
          "required": ["algorithm", "scope", "digest", "excludes"],
          "properties": {
            "algorithm": { "const": "sha256" },
            "scope": { "enum": ["merge-candidate", "committed-range", "none"] },
            "digest": { "$ref": "#/$defs/digest" },
            "excludes": { "type": "array", "items": { "type": "string" } }
          }
        },
        "artifacts": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "path", "digest"],
            "properties": {
              "role": { "enum": ["spec", "plan", "tasks", "validation-report", "research"] },
              "path": { "type": "string", "pattern": "^\\./(?!.*(?:^|/)\\.\\.(?:/|$)).+" },
              "digest": { "$ref": "#/$defs/digest" }
            }
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "completed_conditions", "unresolved_blockers", "evidence_refs"],
      "properties": {
        "result": { "enum": ["pass", "partial", "fail"] },
        "completed_conditions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "unresolved_blockers": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "evidence_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "relations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parent", "children", "supersedes", "superseded_by"],
      "properties": {
        "parent": { "type": ["string", "null"] },
        "children": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "supersedes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "superseded_by": { "type": ["string", "null"] }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "canonicalization", "payload_digest"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "canonicalization": { "type": "string", "minLength": 1 },
        "payload_digest": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
