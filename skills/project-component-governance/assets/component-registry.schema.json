{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agent-foundation/component-registry.schema.json",
  "title": "Component Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "components"],
  "properties": {
    "version": { "const": 1 },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "display_name", "purpose", "location", "source", "level", "status", "keywords", "contract", "public_entry", "replacement", "alternatives", "known_consumers", "validation"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
          "display_name": { "type": "string", "minLength": 1 },
          "purpose": { "type": "string", "minLength": 1 },
          "location": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 },
          "level": { "enum": ["page-local", "app-shared", "project-shared", "project-standard"] },
          "status": { "enum": ["candidate", "active", "migrating", "deprecated", "retired"] },
          "keywords": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "contract": { "type": ["string", "null"] },
          "public_entry": { "type": ["string", "null"] },
          "replacement": { "type": ["string", "null"] },
          "alternatives": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "known_consumers": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "validation": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "exports": { "type": "array", "items": { "type": "string", "pattern": "^(?:default|[A-Za-z_$][A-Za-z0-9_$]*)$" }, "uniqueItems": true }
        }
      }
    }
  }
}
