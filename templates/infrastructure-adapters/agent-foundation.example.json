{
  "schemaVersion": 2,
  "preset": "minimal",
  "metadata": {
    "description": "采用方自有基建接入的合成示例",
    "documentationRef": "https://example.invalid/agent-foundation/integrations",
    "labels": ["example", "project"]
  },
  "directories": {
    "specs": "specs",
    "knowledge": "knowledge"
  },
  "context": {
    "perSpecFullTextBytes": 32768,
    "totalFullTextBytes": 65536,
    "maxIndexEntriesPerArtifact": 256,
    "maxRuleFileBytes": 32768
  },
  "integrations": [
    {
      "capability": "host",
      "adapterId": "example-project-host",
      "configRef": null
    },
    {
      "capability": "source-control",
      "adapterId": "example-source-control",
      "configRef": "env://SYNTHETIC_SOURCE_CONTROL_CONFIG"
    },
    {
      "capability": "work-item",
      "adapterId": "example-work-item",
      "configRef": "env://SYNTHETIC_WORK_ITEM_CONFIG"
    }
  ],
  "safety": {
    "scope": "project",
    "onConflict": "block",
    "followSymlinks": false
  }
}
